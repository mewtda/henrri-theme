{%- liquid
  assign current = collection.handle
  assign visible = ''
  for block in section.blocks
    assign show_on = block.settings.show_on | remove: ' ' | split: ','
    if block.settings.show_on == blank or show_on contains current
      assign visible = visible | append: block.id | append: ','
    endif
  endfor

  comment
    Collections not listed in any button fall back to the buttons of the default collection.
  endcomment
  assign fallback = section.settings.fallback_handle | default: 'all' | strip
  if visible == blank and current != fallback
    for block in section.blocks
      assign show_on = block.settings.show_on | remove: ' ' | split: ','
      if show_on contains fallback
        assign visible = visible | append: block.id | append: ','
      endif
    endfor
  endif
-%}
{%- if visible != blank -%}
  <div class="henrri-pills-wrap page-width">
    <nav class="henrri-pills" aria-label="{{ 'henrri.collection.categories' | t }}">
      {%- for block in section.blocks -%}
        {%- assign marker = block.id | append: ',' -%}
        {%- unless visible contains marker -%}{%- continue -%}{%- endunless -%}
        {%- liquid
          assign target = block.settings.collection
          assign url = target.url | default: block.settings.link
          assign label = block.settings.label | default: target.title
          assign is_active = false
          if target != blank and target.handle == current
            assign is_active = true
          elsif target == blank and block.settings.link != blank
            assign link_path = block.settings.link | split: '?' | first
            if link_path == request.path
              assign is_active = true
            endif
          endif
        -%}
        {%- if block.type == 'back' -%}
          <a href="{{ block.settings.link | default: '/collections/all' }}" class="henrri-pill henrri-pill--back" {{ block.shopify_attributes }}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M11 5l-7 7 7 7 1.4-1.4L7.8 13H20v-2H7.8l4.6-4.6z"/></svg>
            {{- block.settings.label | escape -}}
          </a>
        {%- elsif url != blank -%}
          <a
            href="{{ url }}"
            class="henrri-pill{% if is_active %} is-active{% endif %}"
            {% if is_active %}
              aria-current="page"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {{- label | escape -}}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  </div>
{%- endif -%}

<style>
  .henrri-pills-wrap {
    margin-top: 1.2rem;
    margin-bottom: 1.2rem;
  }

  .henrri-pills {
    display: flex;
    gap: 0.8rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 0.2rem;
  }

  .henrri-pills::-webkit-scrollbar {
    display: none;
  }

  .henrri-pill {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    min-height: 3.8rem;
    padding: 0 1.8rem;
    border: 1px solid rgba(15, 15, 15, 0.25);
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--henrri-black, #0f0f0f);
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
  }

  .henrri-pill:hover {
    border-color: var(--henrri-black, #0f0f0f);
  }

  .henrri-pill--back {
    gap: 0.6rem;
    border-color: transparent;
    padding-left: 0;
    padding-right: 1.2rem;
    margin-right: 0.4rem;
    border-right: 1px solid var(--henrri-border, #ebebeb);
  }

  .henrri-pill--back:hover {
    border-color: transparent;
    border-right-color: var(--henrri-border, #ebebeb);
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  .henrri-pill--back svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .henrri-pill.is-active {
    background: var(--henrri-black, #0f0f0f);
    border-color: var(--henrri-black, #0f0f0f);
    color: #fff;
  }
</style>

{% schema %}
{
  "name": "Henrri: botões categoria",
  "class": "henrri-collection-pills-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Botões que levam para outras coleções. Em cada botão, \"Mostrar nas coleções\" define em quais páginas ele aparece (handles separados por vírgula; vazio = todas)."
    },
    {
      "type": "text",
      "id": "fallback_handle",
      "label": "Coleção padrão",
      "default": "all",
      "info": "Coleções que não aparecem em nenhum \"Mostrar nas coleções\" usam os botões desta coleção."
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Botão",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção" },
        { "type": "url", "id": "link", "label": "Ou link", "info": "Use quando não for uma coleção, ex.: /collections/all" },
        { "type": "text", "id": "label", "label": "Texto do botão", "info": "Se vazio, usa o nome da coleção" },
        { "type": "text", "id": "show_on", "label": "Mostrar nas coleções", "info": "Ex.: maderite, kit-maderite, camiseta-maderite" }
      ]
    },
    {
      "type": "back",
      "name": "Botão voltar",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Todas as categorias" },
        { "type": "url", "id": "link", "label": "Link", "info": "Se vazio, volta para /collections/all" },
        { "type": "text", "id": "show_on", "label": "Mostrar nas coleções", "info": "Ex.: maderite, kit-maderite, camiseta-maderite" }
      ]
    }
  ],
  "presets": [{ "name": "Henrri: botões categoria" }],
  "enabled_on": {
    "templates": ["collection"]
  }
}
{% endschema %}
