{{ 'henrri-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'henrri-carousel.js' | asset_url }}" defer="defer"></script>

<henrri-carousel
  class="henrri-hero henrri-hero--{{ section.settings.height }}"
  data-autoplay="{% if section.settings.autoplay %}{{ section.settings.speed }}{% else %}0{% endif %}"
>
  <ul class="henrri-hero__track" data-track role="list">
    {%- for block in section.blocks -%}
      <li class="henrri-hero__slide" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="henrri-hero__link">
        {%- else -%}
          <div class="henrri-hero__link">
        {%- endif -%}
        <div class="henrri-hero__media">
          {%- if block.settings.image != blank -%}
            {%- liquid
              assign loading = 'lazy'
              assign fetch = 'auto'
              if forloop.first and section.index == 1
                assign loading = 'eager'
                assign fetch = 'high'
              endif
            -%}
            {%- if block.settings.image_mobile != blank -%}
              <picture>
                <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
                {{ block.settings.image | image_url: width: 3000 | image_tag: loading: loading, fetchpriority: fetch, widths: '750, 1100, 1500, 1920, 2500, 3000', sizes: '100vw' }}
              </picture>
            {%- else -%}
              {{ block.settings.image | image_url: width: 3000 | image_tag: loading: loading, fetchpriority: fetch, widths: '750, 1100, 1500, 1920, 2500, 3000', sizes: '100vw' }}
            {%- endif -%}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <div class="henrri-hero__content" style="--overlay: {{ block.settings.overlay | divided_by: 100.0 }};">
          {%- if block.settings.text != blank -%}
            <p class="henrri-hero__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h2 class="henrri-hero__heading">{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <span class="henrri-hero__button">
              {{- block.settings.button_label | escape -}}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13 5l7 7-7 7-1.4-1.4 4.6-4.6H4v-2h12.2l-4.6-4.6z"/></svg>
            </span>
          {%- endif -%}
        </div>
        {%- if block.settings.link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>

  {%- if section.blocks.size > 1 -%}
    <button type="button" class="henrri-hero__arrow henrri-hero__arrow--prev" data-prev aria-label="{{ 'general.slider.previous_slide' | t }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path stroke="currentColor" stroke-width="1.5" fill="none" d="M15 4l-8 8 8 8"/></svg>
    </button>
    <button type="button" class="henrri-hero__arrow henrri-hero__arrow--next" data-next aria-label="{{ 'general.slider.next_slide' | t }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path stroke="currentColor" stroke-width="1.5" fill="none" d="M9 4l8 8-8 8"/></svg>
    </button>
    <div class="henrri-dots henrri-hero__dots" data-dots></div>
  {%- endif -%}

  {%- if section.settings.show_scroll -%}
    <a href="#shopify-section-{{ section.id }}-end" class="henrri-hero__scroll" aria-label="{{ 'accessibility.skip_to_text' | t }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path stroke="currentColor" stroke-width="1.5" fill="none" d="M5 9l7 7 7-7"/></svg>
    </a>
  {%- endif -%}
</henrri-carousel>
<span id="shopify-section-{{ section.id }}-end"></span>
<script>
  (() => {
    // Altura visível do celular abaixo do cabeçalho, para o banner não passar da tela
    const hero = document.currentScript.previousElementSibling.previousElementSibling;
    const fit = () => {
      const top = hero.getBoundingClientRect().top + window.scrollY;
      hero.style.setProperty('--hero-max', `${Math.max(window.innerHeight - top, 240)}px`);
    };
    fit();
    window.addEventListener('load', fit);
    window.addEventListener('resize', fit);
  })();
</script>

{% schema %}
{
  "name": "Henrri: hero",
  "class": "henrri-hero-section",
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Altura",
      "options": [
        { "value": "medium", "label": "Média" },
        { "value": "large", "label": "Grande" },
        { "value": "full", "label": "Tela inteira" }
      ],
      "default": "large"
    },
    { "type": "checkbox", "id": "autoplay", "label": "Trocar slides automaticamente", "default": true },
    { "type": "range", "id": "speed", "label": "Tempo de cada slide (segundos)", "min": 3, "max": 10, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_scroll", "label": "Mostrar seta para rolar", "default": true }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem (desktop)" },
        { "type": "image_picker", "id": "image_mobile", "label": "Imagem (celular)" },
        { "type": "range", "id": "overlay", "label": "Escurecer imagem", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 10 },
        { "type": "text", "id": "text", "label": "Texto pequeno", "default": "A primeira camiseta tech com tecido italiano" },
        { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "CAMISETA <em>Double Tech</em>", "info": "Use itálico para o efeito de letra cursiva" },
        { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "Confira" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Henrri: hero",
      "blocks": [{ "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
