{%- if section.blocks.size > 0 -%}
  <div class="henrri-marquee" style="--marquee-speed: {{ section.settings.speed }}s;" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
    <div class="henrri-marquee__track">
      {%- for i in (1..2) -%}
        <div class="henrri-marquee__group"{% if i == 2 %} aria-hidden="true"{% endif %}>
          {%- for repeat in (1..3) -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.link != blank -%}
                <a
                  href="{{ block.settings.link }}"
                  class="henrri-marquee__item"
                  {% if i == 2 or repeat > 1 %}
                    tabindex="-1"
                  {% endif %}
                  {% if forloop.first and i == 1 and repeat == 1 %}
                    {{ block.shopify_attributes }}
                  {% endif %}
                >
                  {{- block.settings.text | escape -}}
                </a>
              {%- else -%}
                <span class="henrri-marquee__item">{{ block.settings.text | escape }}</span>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Henrri: faixa rolando",
  "class": "henrri-marquee-section",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "Duração de uma volta (segundos)",
      "min": 10,
      "max": 80,
      "step": 5,
      "default": 35
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensagem",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Frete grátis acima de R$ 399"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (aparece sublinhado)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Henrri: faixa rolando",
      "blocks": [
        { "type": "message", "settings": { "text": "Frete grátis acima de R$ 399" } },
        { "type": "message", "settings": { "text": "Troca fácil" } }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
