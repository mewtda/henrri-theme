{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'henrri-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'henrri-carousel.js' | asset_url }}" defer="defer"></script>

<div class="henrri-section color-{{ section.settings.color_scheme }} gradient" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width page-width--wide">
    <div class="henrri-tabs" role="tablist">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="henrri-tabs__tab"
          role="tab"
          id="Tab-{{ section.id }}-{{ forloop.index }}"
          aria-controls="Panel-{{ section.id }}-{{ forloop.index }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          {{ block.shopify_attributes }}
        >
          {{- block.settings.title | escape -}}
        </button>
      {%- endfor -%}
    </div>

    {%- for block in section.blocks -%}
      <div
        class="henrri-tabs__panel"
        role="tabpanel"
        id="Panel-{{ section.id }}-{{ forloop.index }}"
        aria-labelledby="Tab-{{ section.id }}-{{ forloop.index }}"
        {% unless forloop.first %}
          hidden
        {% endunless %}
      >
        <henrri-carousel class="henrri-carousel">
          <ul
            class="henrri-carousel__track"
            data-track
            role="list"
            style="--columns: {{ section.settings.columns }}; --columns-mobile: 2;"
          >
            {%- if block.settings.collection != blank -%}
              {%- for product in block.settings.collection.products limit: section.settings.limit -%}
                <li>
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: 'portrait',
                    show_secondary_image: true,
                    lazy_load: true,
                    show_rating: true,
                    section_id: section.id
                  %}
                </li>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..section.settings.columns) -%}
                <li>{% render 'card-product', show_vendor: false %}</li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
          <button type="button" class="henrri-carousel__arrow henrri-carousel__arrow--prev" data-prev aria-label="{{ 'general.slider.previous_slide' | t }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path stroke="currentColor" stroke-width="1.5" fill="none" d="M15 4l-8 8 8 8"/></svg>
          </button>
          <button type="button" class="henrri-carousel__arrow henrri-carousel__arrow--next" data-next aria-label="{{ 'general.slider.next_slide' | t }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path stroke="currentColor" stroke-width="1.5" fill="none" d="M9 4l8 8-8 8"/></svg>
          </button>
        </henrri-carousel>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    root.querySelectorAll('.henrri-tabs__tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        root.querySelectorAll('.henrri-tabs__tab').forEach((t) => {
          const active = t === tab;
          t.setAttribute('aria-selected', active);
          document.getElementById(t.getAttribute('aria-controls')).hidden = !active;
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Henrri: carrossel abas",
  "class": "henrri-product-carousel-section",
  "settings": [
    { "type": "range", "id": "columns", "label": "Produtos visíveis (desktop)", "min": 3, "max": 6, "step": 1, "default": 5 },
    { "type": "range", "id": "limit", "label": "Máximo de produtos", "min": 4, "max": 24, "step": 1, "default": 12 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de cores", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Espaço acima", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Espaço abaixo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 20 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Aba",
      "settings": [
        { "type": "text", "id": "title", "label": "Título da aba", "default": "Mais vendidos" },
        { "type": "collection", "id": "collection", "label": "Coleção" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Henrri: carrossel abas",
      "blocks": [
        { "type": "tab", "settings": { "title": "Mais vendidos" } },
        { "type": "tab", "settings": { "title": "Lançamentos" } }
      ]
    }
  ]
}
{% endschema %}
