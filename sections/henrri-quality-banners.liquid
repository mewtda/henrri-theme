{{ 'henrri-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_content = false
  for block in section.blocks
    if block.settings.image != blank or block.settings.image_mobile != blank or block.settings.heading != blank
      assign has_content = true
      break
    endif
  endfor
-%}
{%- if has_content or request.design_mode -%}
  <div class="henrri-section" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
    <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
      {%- if section.settings.title != blank -%}
        <h2 class="henrri-title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      <div class="henrri-qbanners henrri-qbanners--{{ section.settings.columns }}">
        {%- for block in section.blocks -%}
          {%- if block.settings.image == blank and block.settings.image_mobile == blank and block.settings.heading == blank -%}
            {%- unless request.design_mode -%}{%- continue -%}{%- endunless -%}
          {%- endif -%}
          <div class="henrri-qbanner henrri-qbanner--{{ block.settings.text_position }}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="henrri-qbanner__link" aria-label="{{ block.settings.heading | default: block.settings.image.alt | escape }}"></a>
            {%- endif -%}
            {%- if block.settings.image != blank or block.settings.image_mobile != blank -%}
              {%- assign desktop = block.settings.image | default: block.settings.image_mobile -%}
              <picture>
                {%- if block.settings.image_mobile != blank -%}
                  <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
                {%- endif -%}
                {{ desktop | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', class: 'henrri-qbanner__img' }}
              </picture>
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg henrri-qbanner__img' }}
            {%- endif -%}
            {%- if block.settings.heading != blank or block.settings.text != blank -%}
              <div class="henrri-qbanner__content" style="color: {{ block.settings.text_color }};">
                {%- if block.settings.heading != blank -%}
                  <h3 class="henrri-qbanner__heading">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="henrri-qbanner__text">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Henrri: banners produto",
  "class": "henrri-quality-banners-section",
  "settings": [
    { "type": "paragraph", "content": "Banners de qualidade do produto (tecido, caimento, tecnologia). Para um banner diferente por produto, conecte a imagem a um metafield de produto (ícone de banco de dados ao lado do campo)." },
    { "type": "text", "id": "title", "label": "Título da seção" },
    { "type": "select", "id": "columns", "label": "Banners por linha (desktop)", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }], "default": "1" },
    { "type": "checkbox", "id": "full_width", "label": "Largura total", "default": false },
    { "type": "range", "id": "padding_top", "label": "Espaço acima", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Espaço abaixo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem (desktop)" },
        { "type": "image_picker", "id": "image_mobile", "label": "Imagem (celular)" },
        { "type": "inline_richtext", "id": "heading", "label": "Título" },
        { "type": "richtext", "id": "text", "label": "Texto" },
        {
          "type": "select",
          "id": "text_position",
          "label": "Posição do texto",
          "options": [
            { "value": "left", "label": "Esquerda" },
            { "value": "center", "label": "Centro" },
            { "value": "right", "label": "Direita" },
            { "value": "below", "label": "Abaixo da imagem" }
          ],
          "default": "left"
        },
        { "type": "color", "id": "text_color", "label": "Cor do texto", "default": "#ffffff" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Henrri: banners produto",
      "blocks": [{ "type": "banner" }, { "type": "banner" }]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
