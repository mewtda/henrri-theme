{% doc %}
  Botões "Leve 2 / Leve 3 / Leve 4" logo acima do botão de comprar: adicionam essa quantidade
  da cor e do tamanho escolhidos direto ao carrinho, usando o formulário de produto do tema.
  Com a Black Friday ligada, mostra quantas camisetas de brinde a quantidade dá (1 a cada 2).

  Preço: o Liquid mostra preço x quantidade e o JS troca pelo preço real do carrinho, porque os
  descontos automáticos da loja (kit 2 = 5%, kit 3 = 7%, desconto por peça, "compre 2 ganhe 1")
  não aparecem no Liquid. O JS cria carrinhos de teste pela Storefront API (sem token, uma
  chamada só para 2, 3 e 4), que não mexem no carrinho do cliente nem disparam os pixels de
  "adicionou ao carrinho". Guarda o resultado por 10 minutos.

  @param {product} product - O produto
  @param {string} product_form_id - Id do formulário de produto
  @param {string} section_id - Id da seção

  @example
  {% render 'henrri-quick-qty', product: product, product_form_id: product_form_id, section_id: section.id %}
{% enddoc %}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign max_qty = variant.quantity_rule.max | default: 999
  if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
    comment
      Estoque que ainda dá para adicionar = estoque - o que já está no carrinho
    endcomment
    assign in_cart = 0
    for item in cart.items
      if item.variant_id == variant.id
        assign in_cart = in_cart | plus: item.quantity
      endif
    endfor
    assign stock_left = variant.inventory_quantity | minus: in_cart
    if stock_left < max_qty
      assign max_qty = stock_left
    endif
  endif
  comment
    Não mostra em itens baratos (embalagem de presente, produto de teste: menos de R$ 20)
    nem em produtos com a tag "sem-leve"
  endcomment
  assign show = false
  if product.available and variant.available and product.gift_card? == false and max_qty >= 2
    assign show = true
  endif
  if product.price < 2000 or product.tags contains 'sem-leve'
    assign show = false
  endif
-%}
{%- comment -%}
  O wrapper com id fica sempre na página: o product-info.js troca o conteúdo dele quando
  o cliente muda cor/tamanho, então preço e estoque são sempre os da variação escolhida.
{%- endcomment -%}
<div id="HenrriQty-{{ section_id }}">
  {%- if show -%}
    <div class="henrri-qty" data-henrri-qty data-form="{{ product_form_id }}" data-section="{{ section_id }}" data-variant="{{ variant.id }}">
      <p class="henrri-qty__label">Leve mais peças</p>
      <div class="henrri-qty__options">
        {%- for qty in (2..4) -%}
          {%- if qty <= max_qty -%}
            {%- assign gifts = qty | divided_by: 2 -%}
            <button type="button" class="henrri-qty__option" data-qty="{{ qty }}">
              <span class="henrri-qty__count">Leve {{ qty }}</span>
              <span class="henrri-qty__prices" data-qty-prices>
                {%- if variant.compare_at_price > variant.price -%}
                  <s class="henrri-qty__compare" data-cents="{{ variant.compare_at_price | times: qty }}">{{ variant.compare_at_price | times: qty | money }}</s>
                {%- endif -%}
                <span class="henrri-qty__price">{{ variant.price | times: qty | money }}</span>
              </span>
              {%- if settings.henrri_bf_enabled -%}
                <span class="henrri-qty__gift">
                  + {{ gifts }} {% if gifts == 1 %}camiseta{% else %}camisetas{% endif %} de brinde
                </span>
              {%- endif -%}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <p class="henrri-qty__hint">Na cor e no tamanho escolhidos, direto para o carrinho.</p>
    </div>
  {%- endif -%}
</div>

  <script>
    (() => {
      if (window.henrriQtyReady) return;
      window.henrriQtyReady = true;

      const CACHE_MS = 10 * 60 * 1000;
      const currency = (window.Shopify && Shopify.currency && Shopify.currency.active) || 'BRL';
      const money = (cents) =>
        (cents / 100).toLocaleString('pt-BR', { style: 'currency', currency });

      const readCache = (key) => {
        try {
          const raw = sessionStorage.getItem(key);
          if (!raw) return null;
          const data = JSON.parse(raw);
          return Date.now() - data.t < CACHE_MS ? data.v : null;
        } catch (e) {
          return null;
        }
      };
      const writeCache = (key, value) => {
        try {
          sessionStorage.setItem(key, JSON.stringify({ v: value, t: Date.now() }));
        } catch (e) {}
      };

      // Um carrinho de teste por quantidade, numa chamada só à Storefront API (sem token).
      // Não usa o carrinho do cliente nem /cart/add, então não mexe no carrinho dele nem dispara pixels.
      const inflight = {};
      const quoteAll = (variantId, quantities) => {
        const key = `henrri-qty2:${variantId}:${quantities.join('-')}`;
        const cached = readCache(key);
        if (cached) return Promise.resolve(cached);
        if (inflight[key]) return inflight[key];
        const gid = `gid://shopify/ProductVariant/${variantId}`;
        const query =
          'mutation {' +
          quantities
            .map(
              (n) =>
                `q${n}: cartCreate(input: { lines: [{ merchandiseId: "${gid}", quantity: ${n} }] }) {` +
                ' cart { totalQuantity cost { totalAmount { amount } }' +
                ' lines(first: 10) { nodes { cost { subtotalAmount { amount } } } } } }'
            )
            .join(' ') +
          ' }';
        inflight[key] = fetch((window.Shopify?.routes?.root || '/') + 'api/2025-01/graphql.json', {
          method: 'POST',
          credentials: 'omit',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ query }),
        })
          .then((r) => (r.ok ? r.json() : null))
          .then((res) => {
            if (!res || !res.data) return null;
            const out = {};
            quantities.forEach((n) => {
              const cart = res.data[`q${n}`]?.cart;
              if (!cart) return;
              const toCents = (v) => Math.round(parseFloat(v) * 100);
              out[n] = {
                count: cart.totalQuantity,
                total: toCents(cart.cost.totalAmount.amount),
                original: cart.lines.nodes.reduce((sum, l) => sum + toCents(l.cost.subtotalAmount.amount), 0),
              };
            });
            writeCache(key, out);
            return out;
          })
          .catch(() => null)
          .finally(() => delete inflight[key]);
        return inflight[key];
      };

      const refresh = async (box) => {
        if (!box || box.dataset.quoted === box.dataset.variant) return;
        box.dataset.quoted = box.dataset.variant;
        const options = [...box.querySelectorAll('.henrri-qty__option')];
        if (!options.length) return;
        box.classList.add('is-loading');
        const quotes = await quoteAll(
          box.dataset.variant,
          options.map((o) => Number(o.dataset.qty))
        );
        box.classList.remove('is-loading');
        if (!quotes) return; // sem resposta: fica o preço do Liquid
        options.forEach((option) => {
          const qty = Number(option.dataset.qty);
          const data = quotes[qty];
          if (!data || !option.isConnected) return;
          if (data.count < qty) {
            option.hidden = true; // não há estoque para essa quantidade
            return;
          }
          const prices = option.querySelector('[data-qty-prices]');
          if (!prices) return;
          const compareEl = prices.querySelector('.henrri-qty__compare');
          const strike = Math.max(data.original, Number(compareEl?.dataset.cents) || 0);
          let html = '';
          if (strike > data.total) html += `<s class="henrri-qty__compare">${money(strike)}</s>`;
          html += `<span class="henrri-qty__price">${money(data.total)}</span>`;
          prices.innerHTML = html;
        });
      };

      let scheduled = false;
      const scan = () => {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(() => {
          scheduled = false;
          document.querySelectorAll('[data-henrri-qty]').forEach(refresh);
        });
      };
      const start = () => {
        scan();
        // o product-info.js troca o quadro quando o cliente muda cor/tamanho
        new MutationObserver(scan).observe(document.body, { childList: true, subtree: true });
      };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
      else start();

      document.addEventListener('click', (e) => {
        const option = e.target.closest('.henrri-qty__option');
        if (!option) return;
        const box = option.closest('[data-henrri-qty]');
        const form = document.getElementById(box.dataset.form);
        if (!form) return;

        const submit = form.querySelector('[type="submit"]');
        if (submit && (submit.disabled || submit.getAttribute('aria-disabled') === 'true')) {
          submit.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }

        const qtyInput = document.querySelector(`input[name="quantity"][form="${form.id}"]`) || form.querySelector('input[name="quantity"]');
        let tempInput = null;
        let previous = null;
        if (qtyInput) {
          previous = qtyInput.value;
          qtyInput.value = option.dataset.qty;
        } else {
          tempInput = document.createElement('input');
          tempInput.type = 'hidden';
          tempInput.name = 'quantity';
          tempInput.value = option.dataset.qty;
          form.appendChild(tempInput);
        }

        // O product-form do tema lê o formulário na hora do envio; depois volta a quantidade como estava
        form.requestSubmit ? form.requestSubmit() : form.dispatchEvent(new Event('submit', { cancelable: true }));
        if (qtyInput) qtyInput.value = previous;
        if (tempInput) tempInput.remove();
      });
    })();
  </script>
