{% doc %}
  Renders the "Vestuário" top-level item, built from the header's collection list setting.

  @param {string} context - 'desktop' for the inline mega menu, 'drawer' for the mobile menu drawer.

  @example
  {% render 'henrri-vestuario-mega', context: 'desktop' %}
{% enddoc %}

{%- liquid
  assign title = section.settings.vestuario_title | default: 'Vestuário'
  assign all_url = section.settings.vestuario_link | default: routes.all_products_collection_url
  assign is_active = false
  for collection_item in section.settings.vestuario_collections
    if collection_item.url == request.path
      assign is_active = true
    endif
  endfor
-%}

{%- if context == 'drawer' -%}
  <li>
    <details id="Details-menu-drawer-menu-item-vestuario">
      <summary
        id="HeaderDrawer-vestuario"
        class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if is_active %} menu-drawer__menu-item--active{% endif %}"
      >
        {{ title | escape }}
        <span class="svg-wrapper">
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </span>
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </summary>
      <div id="link-vestuario" class="menu-drawer__submenu has-submenu gradient motion-reduce" tabindex="-1">
        <div class="menu-drawer__inner-submenu">
          <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
            <span class="svg-wrapper">
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            </span>
            {{ title | escape }}
          </button>
          <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
            {%- for collection_item in section.settings.vestuario_collections -%}
              <li>
                <a
                  href="{{ collection_item.url }}"
                  class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if collection_item.url == request.path %} menu-drawer__menu-item--active{% endif %}"
                >
                  {{ collection_item.title | escape }}
                </a>
              </li>
            {%- endfor -%}
            <li>
              <a href="{{ all_url }}" class="menu-drawer__menu-item link link--text list-menu__item focus-inset">
                Ver tudo
              </a>
            </li>
          </ul>
        </div>
      </div>
    </details>
  </li>
{%- else -%}
  <li>
    <header-menu>
      <details id="Details-HeaderMenu-vestuario" class="mega-menu">
        <summary id="HeaderMenu-vestuario" class="header__menu-item list-menu__item link focus-inset">
          <span{% if is_active %} class="header__active-menu-item"{% endif %}>{{ title | escape }}</span>
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </summary>
        <div
          id="MegaMenu-Content-vestuario"
          class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
          tabindex="-1"
        >
          <div class="henrri-vestuario page-width">
            <div class="henrri-vestuario__links">
              <p class="henrri-vestuario__heading">{{ title | escape }}</p>
              <ul class="list-unstyled" role="list">
                {%- for collection_item in section.settings.vestuario_collections -%}
                  <li>
                    <a
                      href="{{ collection_item.url }}"
                      class="mega-menu__link link{% if collection_item.url == request.path %} mega-menu__link--active{% endif %}"
                      {% if collection_item.url == request.path %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ collection_item.title | escape }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
              <a href="{{ all_url }}" class="henrri-vestuario__all link">Ver tudo</a>
            </div>
            {%- if section.settings.vestuario_show_images -%}
              <ul class="henrri-vestuario__grid" role="list">
                {%- for collection_item in section.settings.vestuario_collections limit: 6 -%}
                  {%- assign collection_image = collection_item.featured_image | default: collection_item.products.first.featured_media.preview_image -%}
                  <li>
                    <a href="{{ collection_item.url }}" class="henrri-vestuario__card">
                      <span class="henrri-vestuario__media">
                        {%- if collection_image != blank -%}
                          {{
                            collection_image
                            | image_url: width: 500
                            | image_tag: loading: 'lazy', widths: '250, 375, 500', sizes: '200px', alt: collection_item.title
                          }}
                        {%- else -%}
                          {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                      </span>
                      <span class="henrri-vestuario__card-title">{{ collection_item.title | escape }}</span>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
      </details>
    </header-menu>
  </li>
{%- endif -%}
